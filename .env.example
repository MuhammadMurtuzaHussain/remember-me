# Everything is optional. With no .env, `npm start` serves the web page and sandbox demo.

# Create a bot with @BotFather and paste its token to turn on the Telegram bot.
# For group capture, also disable "Group Privacy" for the bot in BotFather.
TELEGRAM_BOT_TOKEN=

# Local model (Ollama). Defaults shown.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Web server. Bind to 0.0.0.0 only behind a reverse proxy you control.
HOST=127.0.0.1
PORT=8787

# Data
DB_PATH=data/remember-me.db
RETENTION_DAYS=90

# Demo: auto (live model if Ollama has the model, else replay), replay, or live.
DEMO_MODE=auto
# Set to 1 only when behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=
